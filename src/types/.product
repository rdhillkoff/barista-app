export interface Product {
  id: string;
  sku: string;         // รหัสสินค้า
  name: string;        // ชื่อสินค้า
  category: string;    // ประเภทสินค้า
  brand: string;       // ยี่ห้อ
  color: string;       // สี
  price: number;       // ราคา
}

export interface CartItem extends Product {
  quantity: number;    // จำนวนที่สั่ง
}

export interface Order {
  id: string;
  customerName: string; // ชื่อผู้เรียน / โต๊ะในห้องเทรน
  items: CartItem[];
  totalAmount: number;
  status: 'pending' | 'preparing' | 'completed';
  createdAt: string;
}
